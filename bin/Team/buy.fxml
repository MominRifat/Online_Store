<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Team.buyController">
   <children>
      <AnchorPane layoutY="-13.0" prefHeight="358.0" prefWidth="364.0">
         <children>
            <Label layoutX="151.0" layoutY="55.0" text="Buy">
               <font>
                  <Font size="30.0" />
               </font>
            </Label>
            <Label layoutX="61.0" layoutY="140.0" text="Id">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label layoutX="61.0" layoutY="179.0" text="Quantity">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <TextField fx:id="id" alignment="CENTER" layoutX="151.0" layoutY="141.0" promptText="Id" />
            <TextField fx:id="quantity" alignment="CENTER" layoutX="151.0" layoutY="180.0" promptText="Quantity" />
            <Button fx:id="back" layoutX="69.0" layoutY="296.0" mnemonicParsing="false" onAction="#backToView" text="Back" />
            <Button fx:id="buy" layoutX="259.0" layoutY="295.0" mnemonicParsing="false" onAction="#handleBuy" prefHeight="27.0" prefWidth="41.0" text="Buy" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
