<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Team.CategoryController">
   <children>
      <AnchorPane layoutX="-1.0" layoutY="-9.0" prefHeight="386.0" prefWidth="411.0">
         <children>
            <Label layoutX="122.0" layoutY="49.0" text="Choose Category">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Label layoutX="122.0" layoutY="138.0" text="Food">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Label layoutX="121.0" layoutY="177.0" text="Cloth">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Button fx:id="foodButton" layoutX="237.0" layoutY="141.0" mnemonicParsing="false" onAction="#handleFood" text="Click" />
            <Button fx:id="clothButton" layoutX="237.0" layoutY="180.0" mnemonicParsing="false" onAction="#handleCloth" text="Click" />
            <Button fx:id="backButton" layoutX="185.0" layoutY="267.0" mnemonicParsing="false" onAction="#handleBack" text="Back" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
