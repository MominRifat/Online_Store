<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Store.AdminProductViewController">
   <children>
      <AnchorPane prefHeight="412.0" prefWidth="628.0">
         <children>
            <Label layoutX="173.0" layoutY="14.0" text="View Products (Admin)" textFill="#2397a4">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <TableView fx:id="productTable" layoutX="-1.0" layoutY="62.0" prefHeight="307.0" prefWidth="630.0">
              <columns>
                <TableColumn fx:id="nameColumn" prefWidth="93.60003662109375" text="Name" />
                  <TableColumn fx:id="idColumn" prefWidth="88.0" text="Id" />
                  <TableColumn fx:id="priceColumn" prefWidth="87.99993896484375" text="Price" />
                  <TableColumn fx:id="quantityColumn" prefWidth="79.2000732421875" text="Quantity" />
                <TableColumn fx:id="categoryColumn" prefWidth="98.39996337890625" text="Category" />
                  <TableColumn fx:id="salePercentColumn" minWidth="0.0" prefWidth="102.40008544921875" text="SalePercent" />
                  <TableColumn fx:id="saleColumn" prefWidth="79.9998779296875" text="Sale" />
              </columns>
            </TableView>
            <Button layoutX="294.0" layoutY="372.0" mnemonicParsing="false" onAction="#backToAdminDashBoard" text="Back" textFill="#f20909">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font></Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
