<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Store.AdminController">
   <children>
      <AnchorPane layoutX="-8.0" layoutY="-4.0" prefHeight="383.0" prefWidth="474.0">
         <children>
            <Label layoutX="124.0" layoutY="34.0" text="Admin DashBoard" textFill="#426884">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Button layoutX="137.0" layoutY="105.0" mnemonicParsing="false" onAction="#viewProducts" text="View List of Products" textFill="#39babf">
               <font>
                  <Font name="System Bold" size="19.0" />
               </font>
            </Button>
            <Button layoutX="136.0" layoutY="165.0" mnemonicParsing="false" onAction="#addItem" prefHeight="42.0" prefWidth="214.0" text="Add Item to Store" textFill="#39babf">
               <font>
                  <Font name="System Bold" size="19.0" />
               </font>
            </Button>
            <Button layoutX="137.0" layoutY="232.0" mnemonicParsing="false" onAction="#putOnSale" prefHeight="42.0" prefWidth="214.0" text="Put Item on Sale" textFill="#39babf">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>
            <Button layoutX="214.0" layoutY="295.0" mnemonicParsing="false" onAction="#backToLogin" text="Back" textFill="#f20909">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
