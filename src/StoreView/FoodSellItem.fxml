<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Store.FoodSellController">
   <children>
      <AnchorPane layoutY="-10.0" prefHeight="390.0" prefWidth="396.0">
         <children>
            <Label layoutX="84.0" layoutY="46.0" text="Sell Food Percentage" textFill="#426884">
               <font>
                  <Font name="System Bold" size="25.0" />
               </font>
            </Label>
            <Label layoutX="47.0" layoutY="149.0" text="Food Name" textFill="#2397a4">
               <font>
                  <Font name="System Bold" size="21.0" />
               </font>
            </Label>
            <Label layoutX="47.0" layoutY="206.0" text="Sell percentage" textFill="#2397a4">
               <font>
                  <Font name="System Bold" size="21.0" />
               </font>
            </Label>
            <TextField fx:id="NameField" alignment="CENTER" layoutX="207.0" layoutY="152.0" promptText="Name" />
            <TextField fx:id="percentageField" alignment="CENTER" layoutX="207.0" layoutY="209.0" promptText="Sell percentage" />
            <Button fx:id="backButton" layoutX="83.0" layoutY="299.0" mnemonicParsing="false" onAction="#handleBack" prefHeight="37.0" prefWidth="54.0" text="Back" textFill="#f20909">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <Button fx:id="idSellButton" layoutX="276.0" layoutY="299.0" mnemonicParsing="false" onAction="#handlePutOnSaleById" prefHeight="36.0" prefWidth="53.0" text="Sell" textFill="#33b779">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
